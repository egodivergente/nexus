{
  "components": {
    "schemas": {
      "Input": {
        "properties": {
          "model": {
            "type": "string",
            "description": "model name",
            "default": "tencent/video/upscaler"
          },
          "video_url": {
            "description": "URL of the source video to enhance. Must be a publicly accessible HTTP(S) URL (user-uploaded or third-party-model output are both supported). Signed URLs should be long-lived — Tencent MPS fetches the video before processing.",
            "type": "string",
            "x-accept": "video/*",
            "x-ui-component": "uploader"
          },
          "template": {
            "type": "string",
            "description": "Enhancement template. The frontend shows the label; the backend maps the slug to the corresponding MPS template ID (Definition).",
            "default": "anime-enhance-4k",
            "x-ui-component": "select",
            "enum": [
              "live-action-enhance-720p",
              "live-action-enhance-1080p",
              "live-action-enhance-2k",
              "live-action-enhance-4k",
              "anime-enhance-720p",
              "anime-enhance-1080p",
              "anime-enhance-2k",
              "anime-enhance-4k",
              "restore-720p",
              "restore-1080p",
              "restore-2k",
              "restore-4k",
              "live-action-smallface-720p",
              "live-action-smallface-1080p",
              "live-action-smallface-2k",
              "live-action-smallface-4k",
              "anime-smallface-720p",
              "anime-smallface-1080p",
              "anime-smallface-2k",
              "anime-smallface-4k",
              "seedance2-enhance-720p",
              "seedance2-enhance-1080p",
              "seedance2-enhance-2k",
              "seedance2-enhance-4k"
            ],
            "x-enum-labels": {
              "live-action-enhance-720p": "Live-action · AI Enhance · 720P",
              "live-action-enhance-1080p": "Live-action · AI Enhance · 1080P",
              "live-action-enhance-2k": "Live-action · AI Enhance · 2K",
              "live-action-enhance-4k": "Live-action · AI Enhance · 4K",
              "anime-enhance-720p": "Anime/Comic · AI Enhance · 720P",
              "anime-enhance-1080p": "Anime/Comic · AI Enhance · 1080P",
              "anime-enhance-2k": "Anime/Comic · AI Enhance · 2K",
              "anime-enhance-4k": "Anime/Comic · AI Enhance · 4K",
              "restore-720p": "Old/Low-quality Restore · 720P",
              "restore-1080p": "Old/Low-quality Restore · 1080P",
              "restore-2k": "Old/Low-quality Restore · 2K",
              "restore-4k": "Old/Low-quality Restore · 4K",
              "live-action-smallface-720p": "Live-action · Small-face Optimize · 720P",
              "live-action-smallface-1080p": "Live-action · Small-face Optimize · 1080P",
              "live-action-smallface-2k": "Live-action · Small-face Optimize · 2K",
              "live-action-smallface-4k": "Live-action · Small-face Optimize · 4K",
              "anime-smallface-720p": "Anime/Comic · Small-face Optimize · 720P",
              "anime-smallface-1080p": "Anime/Comic · Small-face Optimize · 1080P",
              "anime-smallface-2k": "Anime/Comic · Small-face Optimize · 2K",
              "anime-smallface-4k": "Anime/Comic · Small-face Optimize · 4K",
              "seedance2-enhance-720p": "Seedance2 Enhance · 720P",
              "seedance2-enhance-1080p": "Seedance2 Enhance · 1080P",
              "seedance2-enhance-2k": "Seedance2 Enhance · 2K",
              "seedance2-enhance-4k": "Seedance2 Enhance · 4K"
            }
          },
          "short": {
            "type": "integer",
            "description": "Output short-edge in pixels. Range is constrained by the chosen template tier (see x-depends-on). Special value 0 = keep source resolution.",
            "default": 0,
            "minimum": 0,
            "maximum": 2160,
            "x-depends-on": {
              "field": "template",
              "conditions": [
                {
                  "when": ["live-action-enhance-720p", "anime-enhance-720p", "restore-720p", "live-action-smallface-720p", "anime-smallface-720p", "seedance2-enhance-720p"],
                  "minimum": 0,
                  "maximum": 720,
                  "description": "720P templates: 0 (keep source) or 1–720"
                },
                {
                  "when": ["live-action-enhance-1080p", "anime-enhance-1080p", "restore-1080p", "live-action-smallface-1080p", "anime-smallface-1080p", "seedance2-enhance-1080p"],
                  "minimum": 721,
                  "maximum": 1080,
                  "description": "1080P templates: 721–1080"
                },
                {
                  "when": ["live-action-enhance-2k", "anime-enhance-2k", "restore-2k", "live-action-smallface-2k", "anime-smallface-2k", "seedance2-enhance-2k"],
                  "minimum": 1081,
                  "maximum": 1440,
                  "description": "2K templates: 1081–1440"
                },
                {
                  "when": ["live-action-enhance-4k", "anime-enhance-4k", "restore-4k", "live-action-smallface-4k", "anime-smallface-4k", "seedance2-enhance-4k"],
                  "minimum": 1441,
                  "maximum": 2160,
                  "description": "4K templates: 1441–2160"
                }
              ]
            }
          },
          "fps": {
            "type": "integer",
            "description": "Smart frame-interpolation target FPS. Omit to keep source frame rate.",
            "minimum": 1
          },
          "keep_metadata": {
            "type": "boolean",
            "description": "Whether to preserve the source media metadata.",
            "default": true
          }
        },
        "required": [
          "model",
          "video_url"
        ],
        "type": "object",
        "x-order-properties": [
          "model",
          "video_url",
          "template",
          "short",
          "fps",
          "keep_metadata"
        ]
      },
      "PredictionResponse": {
        "properties": {
          "created_at": {
            "description": "ISO timestamp of when the request was created.",
            "format": "date-time",
            "type": "string"
          },
          "has_nsfw_contents": {
            "description": "Array of boolean values indicating NSFW detection for each output.",
            "items": {
              "type": "boolean"
            },
            "type": "array"
          },
          "id": {
            "description": "Unique identifier for the prediction.",
            "type": "string"
          },
          "model": {
            "description": "Model ID used for the prediction.",
            "type": "string"
          },
          "outputs": {
            "description": "Array of URLs to the enhanced video(s).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "Status of the task: created, processing, completed, or failed.",
            "type": "string"
          },
          "urls": {
            "description": "Object containing related API endpoints.",
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The AtlasCloud API.",
    "title": "AtlasCloud API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/model/generateVideo": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "The request status."
          }
        }
      },
      "x-api-name": "model_run"
    },
    "/api/v1/model/result/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      },
      "x-api-name": "model_result"
    }
  },
  "servers": [
    {
      "url": "https://api.atlascloud.ai"
    }
  ],
  "model": "tencent/video/upscaler",
  "description": "Tencent Video Upscaler 4K (MPS super-resolution / enhancement)"
}
