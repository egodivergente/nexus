{
  "name": "Pixel ARM64 APK validation",
  "kind": "android-gradle",
  "host_os": [
    "linux",
    "android",
    "windows"
  ],
  "host_arch": [
    "aarch64",
    "arm64"
  ],
  "java_major": 17,
  "compile_sdk": 35,
  "source_includes": [
    "app",
    "gradle",
    "gradlew",
    "gradlew.bat",
    "gradle.properties",
    "settings.gradle.kts",
    "build.gradle.kts"
  ],
  "tasks": [
    ":app:assembleDebug"
  ],
  "artifacts": [
    "app/build/outputs/apk/debug/*.apk"
  ],
  "reports": [
    "app/build/reports/**/*.html",
    "app/build/test-results/**/*.xml"
  ],
  "min_ram_mb": 1100,
  "min_disk_mb": 3072,
  "max_heap_mb": 900,
  "max_memory_mb": 2048,
  "low_impact": true
}