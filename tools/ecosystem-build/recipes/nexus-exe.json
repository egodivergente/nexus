{
  "name": "NEXUS Desktop EXE",
  "kind": "command",
  "host_os": ["windows"],
  "host_arch": ["amd64", "x86_64"],
  "source_includes": ["desktop/build.ps1", "desktop/src", "desktop/ui", "desktop/vendor", "desktop/agent/runtime", "desktop/agent/assets", "desktop/agent/agent-skills", "desktop/local_host.py", "desktop/agent_host.py", "desktop/nexus.ico"],
  "requires_tools": ["csc"],
  "command": ["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "desktop/build.ps1"],
  "artifacts": ["desktop/dist/Nexus.exe", "desktop/dist/*.dll", "desktop/dist/*.py", "desktop/dist/ui/**/*", "desktop/dist/agent/**/*", "desktop/dist/nexus.ico"],
  "min_ram_mb": 512,
  "min_disk_mb": 512,
  "low_impact": true
}
