{
  "name": "NEXUS Flow Agent bounded tests and runtime",
  "kind": "command",
  "host_os": ["linux"],
  "host_arch": ["x86_64", "amd64", "aarch64"],
  "source_includes": [
    "desktop/agent/src", "desktop/agent/core/src",
    "desktop/agent/build.gradle.kts", "desktop/agent/settings.gradle.kts",
    "desktop/agent/gradle.properties", "desktop/agent/gradle-flow.init.gradle",
    "desktop/agent/core/build.gradle.kts", "desktop/agent/agent-skills",
    "desktop/agent/assets", "gradlew", "gradle/wrapper"
  ],
  "requires_tools": ["java"],
  "command": [
    "java", "-classpath", "gradle/wrapper/gradle-wrapper.jar", "org.gradle.wrapper.GradleWrapperMain",
    "-p", "desktop/agent", "-I", "gradle-flow.init.gradle",
    "test", ":core:test", "runtime", "--no-daemon", "--no-parallel", "--max-workers=1",
    "-Dorg.gradle.jvmargs=-Xmx512m -XX:MaxMetaspaceSize=256m -Dfile.encoding=UTF-8",
    "-Pkotlin.compiler.execution.strategy=in-process"
  ],
  "artifacts": ["desktop/agent/build/runtime/*.jar"],
  "reports": ["desktop/agent/build/test-results/**/*.xml", "desktop/agent/core/build/test-results/**/*.xml"],
  "min_ram_mb": 1280,
  "min_disk_mb": 1500,
  "max_memory_mb": 1400,
  "low_impact": true
}
